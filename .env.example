# Server-side API Keys (NEVER expose to frontend)
GOOGLE_AI_API_KEY=
WEATHER_API_KEY=          # Optional: leave blank to use clearly-labelled demo weather data

# Database Configuration (PostgreSQL / Supabase)
# DATABASE_URL: pooled connection string used by the application at runtime (via @prisma/adapter-pg)
DATABASE_URL=
# DIRECT_URL: direct (non-pooled) connection string used by Prisma CLI for migrations and db push
DIRECT_URL=
